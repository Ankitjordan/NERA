# ==============================================================================
# Mappls (MapmyIndia) Authentication Configuration
# Console: https://auth.mappls.com/console
# ==============================================================================

# OPTION 1: Web Maps JS Static Key (Recommended for Web SDK)
# Generated under "APIs & SDKs -> Map SDK -> Web"
VITE_MAPPLS_ACCESS_TOKEN=your_static_web_key_here

# OPTION 2: OAuth 2.0 Credentials (Token Generation API)
# If using OAuth 2.0 Client Credentials instead of a static key
VITE_MAPPLS_CLIENT_ID=your_client_id_here
VITE_MAPPLS_CLIENT_SECRET=your_client_secret_here
