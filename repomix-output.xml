<file path="ui/src/components/MockDriveHUD.tsx">
import React, { useRef, useState } from 'react';
import { motion } from 'framer-motion';
import { Play, Pause, Square } from 'lucide-react';
import { formatDistance } from '../services/mapplsRouteService';

interface MockDriveHUDProps {
  isPaused: boolean;
  speedKmh: number;
  progress: number;
  distanceCoveredM: number;
  totalDistanceM: number;
  currentBearing: number;
  onPause: () => void;
  onResume: () => void;
  onStop: () => void;
  onSpeedChange: (speed: number) => void;
}

const MIN_SPEED = 20;
const MAX_SPEED = 120;
const SPEED_STEP = 5;

export const MockDriveHUD: React.FC<MockDriveHUDProps> = ({
  isPaused,
  speedKmh,
  distanceCoveredM,
  totalDistanceM,
  currentBearing,
  onPause,
  onResume,
  onStop,
  onSpeedChange,
}) => {
  const dialRef = useRef<SVGSVGElement>(null);
  const [isDragging, setIsDragging] = useState(false);

  const calculateSpeedFromEvent = (e: React.PointerEvent) => {
    if (!dialRef.current) return;
    const rect = dialRef.current.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + (150 / 175) * rect.height; // Center aligned with SVG coordinate (160, 150)

    const dx = e.clientX - cx;
    const dy = cy - e.clientY; // standard cartesian Y (up is positive)

    let angleRad = Math.atan2(dy, dx);
    if (angleRad < 0) angleRad = 0;
    if (angleRad > Math.PI) angleRad = Math.PI;

    // angleRad is between 0 (right) and PI (left)
    // We want 20 at left (PI) and 120 at right (0)
    let newSpeed = MAX_SPEED - (angleRad / Math.PI) * (MAX_SPEED - MIN_SPEED);

    // Snap to steps
    newSpeed = Math.round(newSpeed / SPEED_STEP) * SPEED_STEP;
    newSpeed = Math.max(MIN_SPEED, Math.min(MAX_SPEED, newSpeed));

    if (newSpeed !== speedKmh) {
      onSpeedChange(newSpeed);
    }
  };

  const handlePointerDown = (e: React.PointerEvent) => {
    setIsDragging(true);
    (e.target as Element).setPointerCapture(e.pointerId);
    calculateSpeedFromEvent(e);
  };

  const handlePointerMove = (e: React.PointerEvent) => {
    if (!isDragging) return;
    calculateSpeedFromEvent(e);
  };

  const handlePointerUp = (e: React.PointerEvent) => {
    setIsDragging(false);
    (e.target as Element).releasePointerCapture(e.pointerId);
  };

  // Calculate needle angle (-90deg is left/20kmh, +90deg is right/120kmh)
  const needleAngle = ((speedKmh - MIN_SPEED) / (MAX_SPEED - MIN_SPEED)) * 180 - 90;

  // Generate ticks
  const ticks = [];
  for (let s = MIN_SPEED; s <= MAX_SPEED; s += 10) {
    const angle = ((s - MIN_SPEED) / (MAX_SPEED - MIN_SPEED)) * 180 - 90;
    ticks.push({ speed: s, angle });
  }

  return (
    <>
      {/* Top Slim HUD */}
      <motion.div
        className="mock-drive-hud-container"
        initial={{ y: -100, opacity: 0 }}
        animate={{ y: 0, opacity: 1 }}
        exit={{ y: -100, opacity: 0 }}
        transition={{ type: 'spring', damping: 25, stiffness: 200 }}
      >
        <div className="hud-top-bar">
          <div className="hud-stats">
            <div className="hud-stat-item">
              <span className="hud-stat-val">{Math.round(speedKmh)}</span>
              <span className="hud-stat-unit">km/h</span>
            </div>
            <div className="hud-stat-item">
              <span className="hud-stat-val">{formatDistance(distanceCoveredM)}</span>
              <span className="hud-stat-unit">covered</span>
            </div>
            <div className="hud-stat-item">
              <span className="hud-stat-val">{formatDistance(totalDistanceM - distanceCoveredM)}</span>
              <span className="hud-stat-unit">left</span>
            </div>
            <div className="hud-stat-item">
              <span className="hud-stat-val">{currentBearing}°</span>
              <span className="hud-stat-unit">heading</span>
            </div>
          </div>

          <div className="hud-actions">
            {isPaused ? (
              <button className="hud-action-btn" onClick={onResume} title="Resume">
                <Play size={16} fill="currentColor" />
              </button>
            ) : (
              <button className="hud-action-btn" onClick={onPause} title="Pause">
                <Pause size={16} fill="currentColor" />
              </button>
            )}
            <button className="hud-action-btn stop" onClick={onStop} title="Exit Mock Test">
              <Square size={16} fill="currentColor" />
            </button>
          </div>
        </div>
      </motion.div>

      {/* Bottom Semi-Circular Speed Dial */}
      <motion.div
        className="speed-dial-wrapper"
        initial={{ y: 150, opacity: 0 }}
        animate={{ y: 0, opacity: 1 }}
        exit={{ y: 150, opacity: 0 }}
        transition={{ type: 'spring', damping: 25, stiffness: 200, delay: 0.1 }}
      >
        <div className="speed-dial-semi-container">
          <svg
            ref={dialRef}
            width="320"
            height="175"
            viewBox="0 0 320 175"
            onPointerDown={handlePointerDown}
            onPointerMove={handlePointerMove}
            onPointerUp={handlePointerUp}
            onPointerCancel={handlePointerUp}
            style={{ touchAction: 'none', cursor: isDragging ? 'grabbing' : 'grab', overflow: 'visible' }}
          >
            <defs>
              <filter id="dial-glow" x="-30%" y="-30%" width="160%" height="160%">
                <feGaussianBlur stdDeviation="5" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>
              <filter id="inner-shadow">
                <feOffset dx="0" dy="3" />
                <feGaussianBlur stdDeviation="3" result="offset-blur" />
                <feComposite operator="out" in="SourceGraphic" in2="offset-blur" result="inverse" />
                <feFlood floodColor="black" floodOpacity="0.7" result="color" />
                <feComposite operator="in" in="color" in2="inverse" result="shadow" />
                <feComposite operator="over" in="shadow" in2="SourceGraphic" />
              </filter>
              <linearGradient id="track-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stopColor="#00C250" />
                <stop offset="60%" stopColor="#f59e0b" />
                <stop offset="100%" stopColor="#ef4444" />
              </linearGradient>
            </defs>

            {/* Dial Casing / Background Arc */}
            <path
              d="M 65 150 A 95 95 0 0 1 255 150"
              fill="none"
              stroke="rgba(10, 10, 10, 0.85)"
              strokeWidth="32"
              filter="url(#inner-shadow)"
            />

            {/* Active Glow Track */}
            <path
              d="M 65 150 A 95 95 0 0 1 255 150"
              fill="none"
              stroke="url(#track-gradient)"
              strokeWidth="32"
              strokeDasharray="298.45"
              strokeDashoffset={298.45 - (298.45 * ((speedKmh - MIN_SPEED) / (MAX_SPEED - MIN_SPEED)))}
              style={{ transition: isDragging ? 'none' : 'stroke-dashoffset 0.2s cubic-bezier(0.4, 0, 0.2, 1)' }}
            />

            {/* Inner Ring */}
            <path
              d="M 80 150 A 80 80 0 0 1 240 150"
              fill="none"
              stroke="rgba(255, 255, 255, 0.15)"
              strokeWidth="2"
            />

            {/* Ticks and Labels */}
            {ticks.map((t, i) => {
              const isMajor = i % 2 === 0;
              return (
                <g key={t.speed} transform={`translate(160, 150) rotate(${t.angle})`}>
                  <line
                    x1="0" y1={-108}
                    x2="0" y2={isMajor ? -116 : -112}
                    stroke="rgba(255,255,255,0.75)"
                    strokeWidth={isMajor ? "2" : "1"}
                  />
                  {isMajor && (
                    <text
                      x="0" y="-128"
                      textAnchor="middle"
                      dominantBaseline="central"
                      fill="var(--text-main)"
                      fontSize="11"
                      fontWeight="700"
                      style={{ textShadow: '0 2px 4px rgba(0,0,0,0.85)' }}
                      transform={`rotate(${-t.angle}, 0, -128)`}
                    >
                      {t.speed}
                    </text>
                  )}
                </g>
              );
            })}

            {/* Needle */}
            <g transform={`translate(160, 150) rotate(${needleAngle})`} style={{ transition: isDragging ? 'none' : 'transform 0.2s cubic-bezier(0.4, 0, 0.2, 1)' }}>
              {/* Sharp Needle pointer */}
              <polygon points="-4,-16 0,-102 4,-16" fill="#ffffff" filter="url(#dial-glow)" />
              {/* Center Cap Base (Dark Metallic) */}
              <circle cx="0" cy="0" r="20" fill="#111" stroke="#333" strokeWidth="2" filter="url(#inner-shadow)" />
              <circle cx="0" cy="0" r="14" fill="#1a1a1a" stroke="#444" strokeWidth="1" />
              {/* Center Cap Core */}
              <circle cx="0" cy="0" r="7" fill="#ffffff" filter="url(#dial-glow)" />
            </g>
          </svg>
          <div className="speed-dial-title">Cruising Speed</div>
        </div>
      </motion.div>
    </>
  );
};
</file>

<file path="ui/src/components/RouteProgressBar.tsx">
import React, { useEffect, useState } from 'react';
import { Database, Route, Loader2, CheckCircle2, AlertTriangle } from 'lucide-react';
import { fetchSystemStatus } from '../services/mapplsRouteService';
import type { SystemStatus } from '../services/mapplsRouteService';

interface RouteProgressBarProps {
  isLoadingRoute: boolean;
}

const STAGE_CONFIG: Record<string, { icon: React.ReactNode; label: string; color: string; pct: number }> = {
  checking_cache:  { icon: <Database size={14} />,      label: 'Validating graph cache…',     color: '#a78bfa', pct: 5   },
  downloading:     { icon: <Loader2 size={14} className="spin" />, label: 'Downloading NER map data…', color: '#38bdf8', pct: 20  },
  building_graph:  { icon: <Loader2 size={14} className="spin" />, label: 'Building road network…',    color: '#f59e0b', pct: 50  },
  saving_cache:    { icon: <Loader2 size={14} className="spin" />, label: 'Saving graph to cache…',    color: '#fb923c', pct: 80  },
  loading_graph:   { icon: <Loader2 size={14} className="spin" />, label: 'Loading graph into memory…', color: '#22d3ee', pct: 70  },
  ready:           { icon: <CheckCircle2 size={14} />,  label: 'NER routing ready',            color: '#10b981', pct: 100 },
  error:           { icon: <AlertTriangle size={14} />, label: 'Graph error',                  color: '#ef4444', pct: 0   },
};

export const RouteProgressBar: React.FC<RouteProgressBarProps> = ({ isLoadingRoute }) => {
  const [status, setStatus] = useState<SystemStatus | null>(null);
  const [routePhase, setRoutePhase] = useState<'idle' | 'snapping' | 'pathfinding' | 'hazards' | 'done'>('idle');
  const [routePct, setRoutePct] = useState(0);
  const [visible, setVisible] = useState(false);

  // Poll system status when graph isn't ready
  useEffect(() => {
    let interval: ReturnType<typeof setInterval>;
    let mounted = true;

    const poll = async () => {
      const s = await fetchSystemStatus();
      if (!mounted) return;
      setStatus(s);
      if (s && s.state !== 'ready' && s.state !== 'error') {
        setVisible(true);
      }
    };

    poll();
    interval = setInterval(poll, 1500);

    return () => { mounted = false; clearInterval(interval); };
  }, []);

  // Simulate route calculation phases when isLoadingRoute is true
  useEffect(() => {
    if (!isLoadingRoute) {
      if (routePhase !== 'idle') {
        setRoutePhase('done');
        setRoutePct(100);
        const t = setTimeout(() => {
          setRoutePhase('idle');
          setRoutePct(0);
          setVisible(false);
        }, 800);
        return () => clearTimeout(t);
      }
      return;
    }

    setVisible(true);
    setRoutePhase('snapping');
    setRoutePct(10);

    const t1 = setTimeout(() => { setRoutePhase('pathfinding'); setRoutePct(35); }, 400);
    const t2 = setTimeout(() => { setRoutePct(55); }, 1200);
    const t3 = setTimeout(() => { setRoutePhase('hazards'); setRoutePct(75); }, 2500);
    const t4 = setTimeout(() => { setRoutePct(88); }, 4000);

    return () => { clearTimeout(t1); clearTimeout(t2); clearTimeout(t3); clearTimeout(t4); };
  }, [isLoadingRoute]);

  // Determine what to show
  const graphNotReady = status && status.state !== 'ready' && status.state !== 'error';
  const showRouteProgress = isLoadingRoute || routePhase === 'done';
  const shouldShow = visible && (graphNotReady || showRouteProgress);

  if (!shouldShow) return null;

  // Graph loading mode
  if (graphNotReady) {
    const cfg = STAGE_CONFIG[status!.state] || STAGE_CONFIG.loading_graph;
    const pct = status!.percent > 0 ? status!.percent : cfg.pct;

    return (
      <div className="route-progress-overlay">
        <div className="route-progress-card">
          <div className="rp-header">
            <Database size={18} className="rp-header-icon" />
            <span className="rp-title">Initializing NER Road Graph</span>
          </div>
          <div className="rp-stage-row">
            <span className="rp-stage-icon" style={{ color: cfg.color }}>{cfg.icon}</span>
            <span className="rp-stage-label">{status!.message || cfg.label}</span>
          </div>
          <div className="rp-bar-track">
            <div
              className="rp-bar-fill"
              style={{ width: `${pct}%`, background: `linear-gradient(90deg, ${cfg.color}, ${cfg.color}dd)` }}
            />
          </div>
          <div className="rp-meta">
            <span className="rp-pct">{Math.round(pct)}%</span>
            <span className="rp-hint">8-state NER coverage · first-time setup</span>
          </div>
        </div>
      </div>
    );
  }

  // Route calculation mode
  const routeLabels: Record<string, string> = {
    snapping: 'Snapping to nearest road…',
    pathfinding: 'Running A* pathfinder…',
    hazards: 'Evaluating hazard zones…',
    done: 'Route ready!',
  };

  const routeColors: Record<string, string> = {
    snapping: '#a78bfa',
    pathfinding: '#38bdf8',
    hazards: '#f59e0b',
    done: '#10b981',
  };

  return (
    <div className="route-progress-overlay">
      <div className="route-progress-card route-progress-compact">
        <div className="rp-header">
          <Route size={16} className="rp-header-icon" />
          <span className="rp-title">Calculating Safe Route</span>
        </div>
        <div className="rp-stage-row">
          <span className="rp-stage-icon" style={{ color: routeColors[routePhase] || '#a78bfa' }}>
            {routePhase === 'done' ? <CheckCircle2 size={14} /> : <Loader2 size={14} className="spin" />}
          </span>
          <span className="rp-stage-label">{routeLabels[routePhase] || 'Preparing…'}</span>
        </div>
        <div className="rp-bar-track">
          <div
            className="rp-bar-fill rp-bar-animated"
            style={{
              width: `${routePct}%`,
              background: `linear-gradient(90deg, ${routeColors[routePhase] || '#a78bfa'}, ${routeColors[routePhase] || '#a78bfa'}dd)`,
            }}
          />
        </div>
        <div className="rp-meta">
          <span className="rp-pct">{routePct}%</span>
          <span className="rp-hint">NER OSM Graph · A* · Haversine Heuristic</span>
        </div>
      </div>
    </div>
  );
};
</file>

<file path="ui/src/components/RouteSearchBox.tsx">
import React, { useState, useEffect, useRef } from 'react';
import {
  Navigation,
  ArrowUpDown,
  Crosshair,
  Building2,
  Plane,
  Train,
  Loader2,
  X,
  MapPin,
} from 'lucide-react';
import { fetchAutosuggest, geocodePlace } from '../services/mapplsRouteService';
import type { PlaceSuggestion } from '../services/mapplsRouteService';

export interface LocationPoint {
  name: string;
  lat: number;
  lng: number;
}

interface RouteSearchBoxProps {
  token: string;
  origin: LocationPoint | null;
  destination: LocationPoint | null;
  isLoadingRoute: boolean;
  onSetOrigin: (point: LocationPoint | null) => void;
  onSetDestination: (point: LocationPoint | null) => void;
  onCalculateRoute: (o?: LocationPoint, d?: LocationPoint) => void;
}

export const RouteSearchBox: React.FC<RouteSearchBoxProps> = ({
  token, origin, destination, isLoadingRoute,
  onSetOrigin, onSetDestination, onCalculateRoute,
}) => {
  const [oText, setOText] = useState(origin?.name || '');
  const [dText, setDText] = useState(destination?.name || '');
  const [oSug, setOSug] = useState<PlaceSuggestion[]>([]);
  const [dSug, setDSug] = useState<PlaceSuggestion[]>([]);
  const [drop, setDrop] = useState<'o' | 'd' | null>(null);
  const [searchO, setSearchO] = useState(false);
  const [searchD, setSearchD] = useState(false);
  const [resolving, setResolving] = useState(false);
  const [gpsing, setGpsing] = useState(false);
  const boxRef = useRef<HTMLDivElement>(null);

  useEffect(() => { if (origin) setOText(origin.name); }, [origin]);
  useEffect(() => { if (destination) setDText(destination.name); }, [destination]);

  useEffect(() => {
    const h = (e: MouseEvent) => { if (boxRef.current && !boxRef.current.contains(e.target as Node)) setDrop(null); };
    document.addEventListener('mousedown', h);
    return () => document.removeEventListener('mousedown', h);
  }, []);

  // Origin autosuggest
  useEffect(() => {
    if (!oText || oText === origin?.name || oText.trim().length < 2) { setOSug([]); return; }
    const t = setTimeout(async () => {
      setSearchO(true);
      setOSug(await fetchAutosuggest(oText, token));
      setSearchO(false);
      setDrop('o');
    }, 220);
    return () => clearTimeout(t);
  }, [oText, origin, token]);

  // Dest autosuggest
  useEffect(() => {
    if (!dText || dText === destination?.name || dText.trim().length < 2) { setDSug([]); return; }
    const t = setTimeout(async () => {
      setSearchD(true);
      setDSug(await fetchAutosuggest(dText, token, origin ? { lat: origin.lat, lng: origin.lng } : undefined));
      setSearchD(false);
      setDrop('d');
    }, 220);
    return () => clearTimeout(t);
  }, [dText, destination, origin, token]);

  const pick = async (item: PlaceSuggestion, tgt: 'o' | 'd') => {
    let lat = item.latitude, lng = item.longitude;
    if (!lat || !lng) {
      setResolving(true);
      const g = await geocodePlace(`${item.placeName}, ${item.placeAddress}`, token);
      setResolving(false);
      if (g) { lat = g.lat; lng = g.lng; }
    }
    if (lat && lng) {
      const p: LocationPoint = { name: item.placeName || item.placeAddress, lat, lng };
      tgt === 'o' ? (setOText(p.name), onSetOrigin(p)) : (setDText(p.name), onSetDestination(p));
    }
    setDrop(null);
  };

  const swap = () => {
    const to = origin, tt = oText;
    onSetOrigin(destination); setOText(dText);
    onSetDestination(to); setDText(tt);
  };

  const gps = () => {
    if (!navigator.geolocation) return;
    setGpsing(true);
    navigator.geolocation.getCurrentPosition(
      p => { setGpsing(false); const pt: LocationPoint = { name: 'Current Location', lat: p.coords.latitude, lng: p.coords.longitude }; setOText(pt.name); onSetOrigin(pt); },
      () => { setGpsing(false); const fb: LocationPoint = { name: 'Guwahati, Assam', lat: 26.1445, lng: 91.7362 }; setOText(fb.name); onSetOrigin(fb); },
      { timeout: 8000, enableHighAccuracy: true }
    );
  };

  const submit = async (e?: React.FormEvent) => {
    if (e) e.preventDefault();
    setDrop(null);
    let ao = origin, ad = destination;
    setResolving(true);
    try {
      if ((!ao || ao.name !== oText) && oText.trim()) {
        const g = await geocodePlace(oText, token);
        if (g) { ao = { name: oText, lat: g.lat, lng: g.lng }; onSetOrigin(ao); }
      }
      if ((!ad || ad.name !== dText) && dText.trim()) {
        const g = await geocodePlace(dText, token);
        if (g) { ad = { name: dText, lat: g.lat, lng: g.lng }; onSetDestination(ad); }
      }
    } finally { setResolving(false); }
    if (ao && ad) onCalculateRoute(ao, ad);
  };

  const icon = (t: string) => {
    const l = (t || '').toLowerCase();
    if (l.includes('airport')) return <Plane size={14} />;
    if (l.includes('rail') || l.includes('station')) return <Train size={14} />;
    if (l.includes('city') || l.includes('locality')) return <Building2 size={14} />;
    return <MapPin size={14} />;
  };

  return (
    <div className="search-card" ref={boxRef}>
      <form onSubmit={submit} className="search-form">
        {/* Origin */}
        <div className="search-row">
          <span className="marker-dot origin">A</span>
          <div className="search-input-wrap">
            <input placeholder="Starting point" value={oText}
              onChange={e => setOText(e.target.value)}
              onFocus={() => oSug.length && setDrop('o')}
              onKeyDown={e => e.key === 'Enter' && submit()} />
            {searchO && <Loader2 size={13} className="spin field-spinner" />}
            {oText && <button type="button" className="field-clear" onClick={() => { setOText(''); onSetOrigin(null); }}><X size={12} /></button>}
          </div>
          <button type="button" className="gps-btn" onClick={gps} disabled={gpsing}>
            {gpsing ? <Loader2 size={13} className="spin" /> : <Crosshair size={13} />}
          </button>
          {drop === 'o' && oSug.length > 0 && (
            <div className="suggest-drop">
              {oSug.map(s => (
                <div key={s.eLoc || s.placeName} className="suggest-item" onClick={() => pick(s, 'o')}>
                  <span className="suggest-icon">{icon(s.type)}</span>
                  <div className="suggest-text">
                    <span className="suggest-name">{s.placeName}</span>
                    {s.placeAddress && <span className="suggest-addr">{s.placeAddress}</span>}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* Swap */}
        <div className="swap-line">
          <span className="dotted-line" />
          <button type="button" className="swap-btn" onClick={swap}><ArrowUpDown size={13} /></button>
        </div>

        {/* Destination */}
        <div className="search-row">
          <span className="marker-dot dest">B</span>
          <div className="search-input-wrap">
            <input placeholder="Destination" value={dText}
              onChange={e => setDText(e.target.value)}
              onFocus={() => dSug.length && setDrop('d')}
              onKeyDown={e => e.key === 'Enter' && submit()} />
            {searchD && <Loader2 size={13} className="spin field-spinner" />}
            {dText && <button type="button" className="field-clear" onClick={() => { setDText(''); onSetDestination(null); }}><X size={12} /></button>}
          </div>
          {drop === 'd' && dSug.length > 0 && (
            <div className="suggest-drop">
              {dSug.map(s => (
                <div key={s.eLoc || s.placeName} className="suggest-item" onClick={() => pick(s, 'd')}>
                  <span className="suggest-icon">{icon(s.type)}</span>
                  <div className="suggest-text">
                    <span className="suggest-name">{s.placeName}</span>
                    {s.placeAddress && <span className="suggest-addr">{s.placeAddress}</span>}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* Submit */}
        <button type="submit" disabled={(!oText.trim() && !origin) || (!dText.trim() && !destination) || isLoadingRoute || resolving} className="route-btn">
          {isLoadingRoute || resolving ? <><Loader2 size={15} className="spin" /> Finding route…</> : <><Navigation size={15} /> Get Directions</>}
        </button>
      </form>
    </div>
  );
};
</file>

<file path="ui/src/components/TokenModal.tsx">
import React, { useState } from 'react';
import { Key, Shield, ExternalLink, X, CheckCircle2, AlertCircle, RefreshCw, Zap } from 'lucide-react';
import { requestMapplsOAuthToken } from '../services/mapplsAuth';

interface TokenModalProps {
  isOpen: boolean;
  currentToken: string;
  onClose: () => void;
  onSaveToken: (token: string) => void;
}

export const TokenModal: React.FC<TokenModalProps> = ({
  isOpen,
  currentToken,
  onClose,
  onSaveToken,
}) => {
  const [authMode, setAuthMode] = useState<'static' | 'oauth'>('static');
  const [staticKey, setStaticKey] = useState(currentToken);
  const [clientId, setClientId] = useState(import.meta.env.VITE_MAPPLS_CLIENT_ID || '');
  const [clientSecret, setClientSecret] = useState(import.meta.env.VITE_MAPPLS_CLIENT_SECRET || '');
  const [isGenerating, setIsGenerating] = useState(false);
  const [oauthError, setOauthError] = useState<string | null>(null);
  const [oauthSuccess, setOauthSuccess] = useState<string | null>(null);

  if (!isOpen) return null;

  const handleStaticSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    onSaveToken(staticKey.trim());
    onClose();
  };

  const handleOAuthGenerate = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!clientId.trim() || !clientSecret.trim()) {
      setOauthError('Please enter both Client ID and Client Secret.');
      return;
    }

    setIsGenerating(true);
    setOauthError(null);
    setOauthSuccess(null);

    try {
      const response = await requestMapplsOAuthToken(clientId, clientSecret);
      if (response.access_token) {
        setOauthSuccess(`Access token generated successfully! (Expires in ${response.expires_in}s)`);
        onSaveToken(response.access_token);
        setTimeout(() => {
          onClose();
        }, 1200);
      } else {
        setOauthError('No access token received in response.');
      }
    } catch (err: any) {
      setOauthError(err?.message || 'Failed to generate OAuth token. Check your credentials.');
    } finally {
      setIsGenerating(false);
    }
  };

  return (
    <div className="modal-backdrop">
      <div className="modal-card">
        <div className="modal-header">
          <div className="modal-header-left">
            <div className="modal-icon-badge">
              <Key size={20} />
            </div>
            <div>
              <h3 className="modal-title">Mappls Authentication Setup</h3>
              <p className="modal-subtitle">Web Maps JavaScript SDK & OAuth 2.0</p>
            </div>
          </div>
          <button className="modal-close-btn" onClick={onClose}>
            <X size={18} />
          </button>
        </div>

        {/* Tab Switcher */}
        <div className="auth-tab-row">
          <button
            type="button"
            className={`auth-tab-btn ${authMode === 'static' ? 'active' : ''}`}
            onClick={() => setAuthMode('static')}
          >
            <Zap size={14} />
            Static Key / Web Token
          </button>
          <button
            type="button"
            className={`auth-tab-btn ${authMode === 'oauth' ? 'active' : ''}`}
            onClick={() => setAuthMode('oauth')}
          >
            <RefreshCw size={14} />
            OAuth 2.0 (Client ID & Secret)
          </button>
        </div>

        {authMode === 'static' ? (
          <form onSubmit={handleStaticSubmit} className="modal-form">
            <div className="form-group">
              <label className="form-label">Static Key / Web SDK Token</label>
              <input
                type="text"
                className="token-input-field"
                placeholder="Paste static key from Mappls Console..."
                value={staticKey}
                onChange={(e) => setStaticKey(e.target.value)}
                autoFocus
              />
            </div>

            <div className="token-instructions">
              <div className="instruction-item">
                <CheckCircle2 size={15} className="inst-icon success" />
                <span>
                  Get your static key from{' '}
                  <a
                    href="https://auth.mappls.com/console"
                    target="_blank"
                    rel="noreferrer"
                    className="link-highlight"
                  >
                    auth.mappls.com/console <ExternalLink size={11} style={{ display: 'inline', verticalAlign: 'middle' }} />
                  </a>
                </span>
              </div>
              <div className="instruction-item">
                <Shield size={15} className="inst-icon primary" />
                <span>
                  Save in <code>ui/.env.local</code>:
                </span>
              </div>
              <pre className="env-code-block">
                VITE_MAPPLS_ACCESS_TOKEN={staticKey || 'your_static_key_here'}
              </pre>
            </div>

            <div className="modal-actions">
              <button type="button" className="btn-secondary" onClick={onClose}>
                Cancel
              </button>
              <button type="submit" className="btn-primary">
                Save & Apply Key
              </button>
            </div>
          </form>
        ) : (
          <form onSubmit={handleOAuthGenerate} className="modal-form">
            <div className="form-group">
              <label className="form-label">Client ID</label>
              <input
                type="text"
                className="token-input-field"
                placeholder="e.g. 960xxxxxxxxxxxxxxxxxxxxxxxxxx"
                value={clientId}
                onChange={(e) => setClientId(e.target.value)}
              />
            </div>

            <div className="form-group">
              <label className="form-label">Client Secret</label>
              <input
                type="password"
                className="token-input-field"
                placeholder="e.g. lrFxJa5xxxxxxxxxxxxxxxxxxxx"
                value={clientSecret}
                onChange={(e) => setClientSecret(e.target.value)}
              />
            </div>

            {oauthError && (
              <div className="auth-alert error">
                <AlertCircle size={15} className="shrink-0" />
                <span>{oauthError}</span>
              </div>
            )}

            {oauthSuccess && (
              <div className="auth-alert success">
                <CheckCircle2 size={15} className="shrink-0" />
                <span>{oauthSuccess}</span>
              </div>
            )}

            <div className="token-instructions">
              <div className="instruction-item">
                <Shield size={15} className="inst-icon primary" />
                <span>
                  Calls <code>https://outpost.mappls.com/api/security/oauth/token</code> via client_credentials grant.
                </span>
              </div>
              <div className="instruction-item">
                <span>Or save in <code>ui/.env.local</code>:</span>
              </div>
              <pre className="env-code-block">
                VITE_MAPPLS_CLIENT_ID={clientId || 'your_client_id'}{'\n'}
                VITE_MAPPLS_CLIENT_SECRET={clientSecret || 'your_client_secret'}
              </pre>
            </div>

            <div className="modal-actions">
              <button type="button" className="btn-secondary" onClick={onClose}>
                Cancel
              </button>
              <button
                type="submit"
                disabled={isGenerating}
                className="btn-primary flex items-center gap-2"
              >
                {isGenerating && <RefreshCw size={14} className="animate-spin" />}
                {isGenerating ? 'Generating Token...' : 'Generate & Load Map'}
              </button>
            </div>
          </form>
        )}
      </div>
    </div>
  );
};
</file>

