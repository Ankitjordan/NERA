<file path="Routing Engine/internal/poc/graph/store.go">
package graph

import (
	"encoding/gob"
	"fmt"
	"os"
)

// SaveToFile serializes the Graph to a gob file.
func (g *Graph) SaveToFile(filepath string) error {
	file, err := os.Create(filepath)
	if err != nil {
		return fmt.Errorf("could not create file %s: %w", filepath, err)
	}
	defer file.Close()

	encoder := gob.NewEncoder(file)
	if err := encoder.Encode(g); err != nil {
		return fmt.Errorf("failed to encode graph: %w", err)
	}
	return nil
}

// LoadFromFile deserializes the Graph from a gob file.
func LoadFromFile(filepath string) (*Graph, error) {
	file, err := os.Open(filepath)
	if err != nil {
		return nil, fmt.Errorf("could not open file %s: %w", filepath, err)
	}
	defer file.Close()

	var g Graph
	decoder := gob.NewDecoder(file)
	if err := decoder.Decode(&g); err != nil {
		return nil, fmt.Errorf("failed to decode graph: %w", err)
	}
	return &g, nil
}
</file>

<file path="Routing Engine/internal/poc/osm/converter.go">
package osm

import (
	"routing-engine/internal/models"
	"routing-engine/internal/poc/graph"
)

// GraphRouteResult represents the ordered map geometry of a calculated route.
type GraphRouteResult struct {
	Coordinates []models.Coordinate
	DistanceM   float64
}

// ConvertPathToGeometry transforms a graph path (edges) into ordered latitude/longitude coordinates.
func ConvertPathToGeometry(g *graph.Graph, path *graph.PathResult) *GraphRouteResult {
	if path == nil || len(path.Edges) == 0 {
		return &GraphRouteResult{
			Coordinates: []models.Coordinate{},
			DistanceM:   0,
		}
	}

	var coords []models.Coordinate

	// Add the starting node of the first edge
	startEdge := path.Edges[0]
	if int(startEdge.From) < len(g.NodeCoords) {
		startCoord := g.NodeCoords[startEdge.From]
		if startCoord.Lat != 0 && startCoord.Lon != 0 {
			coords = append(coords, models.Coordinate{
				Lat: startCoord.Lat,
				Lng: startCoord.Lon,
			})
		}
	}

	// Add the destination node of every edge to build the continuous sequence
	for _, edge := range path.Edges {
		if int(edge.To) < len(g.NodeCoords) {
			nodeCoord := g.NodeCoords[edge.To]
			if nodeCoord.Lat != 0 && nodeCoord.Lon != 0 {
				coords = append(coords, models.Coordinate{
					Lat: nodeCoord.Lat,
					Lng: nodeCoord.Lon, // Note: graph.Coordinate uses 'Lon', models.Coordinate uses 'Lng'
				})
			}
		}
	}

	return &GraphRouteResult{
		Coordinates: coords,
		DistanceM:   path.TotalWeight, // In our POC, TotalWeight is strictly physical distance in meters
	}
}
</file>

<file path="Routing Engine/internal/poc/osm/nearest.go">
package osm

import (
	"errors"
	"routing-engine/internal/models"
	"routing-engine/internal/poc/graph"
	"routing-engine/internal/utils"
)

// FindNearestNode searches the graph for the closest physical drivable node to a target coordinate.
func FindNearestNode(g *graph.Graph, target models.Coordinate, maxSnapDistanceM float64) (int32, float64, error) {
	if g == nil || len(g.NodeCoords) == 0 {
		return -1, 0, errors.New("empty graph")
	}

	var bestNodeID int32 = -1
	minDistance := -1.0

	// Iterate over the flat array of coordinates (extremely fast)
	for i, coords := range g.NodeCoords {
		// Only snap to nodes that have outgoing edges (so we can actually start a route from there)
		if len(g.Nodes[i]) == 0 {
			continue
		}

		dist := utils.HaversineDistanceM(coords.Lat, coords.Lon, target.Lat, target.Lng)

		if minDistance == -1.0 || dist < minDistance {
			minDistance = dist
			bestNodeID = int32(i)
		}
	}

	if bestNodeID == -1 || minDistance > maxSnapDistanceM {
		return -1, minDistance, errors.New("no drivable road found within snap distance")
	}

	return bestNodeID, minDistance, nil
}
</file>

